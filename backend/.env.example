# Copy this file to ".env" (same folder) and fill in your own values.

# Port the website + API will run on  ->  http://localhost:3000
PORT=3000

# MySQL connection (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-this-to-your-own-password
DB_NAME=campus_events

# Set to true for cloud databases (TiDB Cloud, Railway, ...). Keep false for local MySQL.
DB_SSL=false

# Secret used to sign login tokens. Use any long random text.
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
